# Generate a private .env with ./scripts/setup.sh. Never commit it.
#
#   ./scripts/setup.sh                             this machine only (http://localhost:3000)
#   ./scripts/setup.sh http://10.30.1.77:3000      a server other machines reach over plain HTTP
#   ./scripts/setup.sh https://notes.example.com   a server behind a reverse proxy that provides HTTPS
#
# Only what the server needs before it can read its own settings lives here. Everything else is set on the
# admin panel (/admin) and kept in the database: provider API keys, models, live transcription limits,
# sign-in and the Google client, storage, and the iPhone app's identifiers.

# ── Always: two secrets, made by setup.sh ───────────────────────────────────
POSTGRES_PASSWORD=replace-with-random-database-password
# The bootstrap owner token: always accepted as a bearer token, so the owner cannot be locked out.
# It is also the setup code a new server asks for on its first page ("Claim this server").
ADMIN_API_TOKEN=replace-with-random-64-character-token

# ── Only when the server is not at http://localhost:3000: written by `setup.sh <address>` ──
# The address people open. Sign-in, links to notes and the apps' connection are built from it, so it is read
# once at start-up and is not a setting on the admin panel: a wrong value there could not be undone from a
# browser that can no longer sign in. Plain http works on any host; Google sign-in, Google Calendar and
# AI app connections need https (or localhost), and the pages say so.
# PUBLIC_BASE_URL=http://10.30.1.77:3000
# Which network interface Compose publishes the port on (0.0.0.0: every interface; 127.0.0.1: this machine
# only, as behind a reverse proxy) and the port on this machine.
# BIND_ADDRESS=0.0.0.0
# PORT=3000

# ── Everything below is optional ────────────────────────────────────────────
# Running the server outside Docker (bun run dev): where its database is. `setup.sh --dev` writes this line.
# Compose gives its own containers their database address and does not read it.
# DATABASE_URL=postgresql://meeting_notes:replace-with-random-database-password@127.0.0.1:54329/meeting_notes?schema=public
# Explicit development frontend origins; leave unset when serving web + API together.
# AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional for development; Compose uses its private audio-data volume.
# AUDIO_STORAGE_DIR=/absolute/private/audio/path

# Downloads: the server offers the Mac app for its own version from a directory of builds
# (Cereal-<version>-mac-arm64.dmg, and .zip for updates). Compose mounts DOWNLOADS_HOST_DIR there, read-only;
# the default is ./dist/release, where scripts/release-macos.sh writes. Outside Compose, DOWNLOADS_DIR names
# the directory itself (default /data/downloads).
# DOWNLOADS_HOST_DIR=./dist/release

# Storage: recorded audio and published builds are kept on local disk, or in an S3-compatible bucket chosen
# on the admin panel (Storage). These are only a fallback for a server whose panel has never saved storage
# settings; once it has, they are ignored. scripts/publish-release.ts also reads S3_SECRET_ACCESS_KEY, because
# the server never returns the secret.
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_PREFIX=cereal/
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# The Google client is entered on the admin panel (Sign-in). These two are only a fallback for the calendar
# connection when nothing is saved there.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Upgrading from an earlier version: provider keys and model names that are still in your .env
# (OPENROUTER_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, ELEVENLABS_API_KEY, OPENROUTER_MODEL,
# ELEVENLABS_STT_MODEL, LIVE_MAX_SESSIONS, LIVE_HOLD_SECONDS, IOS_APP_IDS, IOS_APP_STORE_ID) are taken into
# the database the first time the new server starts and are not read again. The admin panel lists the ones
# you can then delete from this file.
