# Generate a private .env with ./scripts/setup.sh. Never commit it.
POSTGRES_PASSWORD=replace-with-random-database-password
ADMIN_API_TOKEN=replace-with-random-64-character-token
DATABASE_URL=postgresql://meeting_notes:replace-with-random-database-password@127.0.0.1:54329/meeting_notes?schema=public
PORT=3000
BIND_ADDRESS=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
# Explicit development frontend origins; leave unset when serving web + API together.
# AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Server-only providers. Leave empty to keep provider features unavailable.
ELEVENLABS_API_KEY=
# Which models are used (chat, meeting notes, speech-to-text, live transcription) is chosen on the admin
# panel and stored in the database, not here. Provider keys can be saved there too; a saved key overrides these.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-sol
# Tool planner must support Chat Completions function calling.
OPENROUTER_TOOL_MODEL=openai/gpt-6-sol
# Optional for development; Compose uses its private audio-data volume.
# AUDIO_STORAGE_DIR=/absolute/private/audio/path

# Optional Google Calendar integration: Web OAuth client, exact callback below.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Register PUBLIC_BASE_URL/api/integrations/google/callback in Google Cloud.

# Optional direct language providers, configurable in instance settings as well.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
