{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ChatInput",
  "$defs": {
    "ChatMessageDTO": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": true
    },
    "ChatInput": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChatMessageDTO"
          },
          "maxItems": 30
        },
        "includeSources": {
          "type": "boolean"
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "message",
        "history"
      ],
      "additionalProperties": true
    }
  }
}
