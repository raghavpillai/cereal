{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ProviderStatusDTO",
  "$defs": {
    "ProviderStatusDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "openrouter",
            "openai",
            "anthropic",
            "elevenlabs"
          ]
        },
        "configured": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "environment",
            "stored",
            "none"
          ]
        }
      },
      "required": [
        "id",
        "configured",
        "source"
      ],
      "additionalProperties": true
    }
  }
}
