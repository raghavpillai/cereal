{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/OnboardingDTO",
  "$defs": {
    "Timestamp": {
      "type": "string"
    },
    "OnboardingStepsDTO": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "boolean"
        },
        "name": {
          "type": "boolean"
        },
        "language": {
          "type": "boolean"
        },
        "speech": {
          "type": "boolean"
        },
        "models": {
          "type": "boolean"
        },
        "signIn": {
          "type": "boolean"
        },
        "storage": {
          "type": "boolean"
        }
      },
      "required": [
        "owner",
        "name",
        "language",
        "speech",
        "models",
        "signIn",
        "storage"
      ],
      "additionalProperties": true
    },
    "OnboardingDTO": {
      "type": "object",
      "properties": {
        "completedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "$ref": "#/$defs/OnboardingStepsDTO"
        }
      },
      "required": [
        "completedAt",
        "steps"
      ],
      "additionalProperties": true
    }
  }
}
