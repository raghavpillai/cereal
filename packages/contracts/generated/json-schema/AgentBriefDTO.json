{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AgentBriefDTO",
  "$defs": {
    "Timestamp": {
      "type": "string"
    },
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "AgentBriefDTO": {
      "type": "object",
      "properties": {
        "body": {
          "type": "string"
        },
        "updatedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceId": {
          "$ref": "#/$defs/UUID"
        },
        "source": {
          "type": "string",
          "enum": [
            "explicit_user_profile"
          ]
        },
        "automaticallyInferred": {
          "type": "boolean",
          "enum": [
            false
          ]
        }
      },
      "required": [
        "body",
        "updatedAt",
        "workspaceId",
        "source",
        "automaticallyInferred"
      ],
      "additionalProperties": true
    }
  }
}
