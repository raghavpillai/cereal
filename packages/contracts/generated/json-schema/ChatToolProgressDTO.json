{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ChatToolProgressDTO",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "ChatToolMeetingDTO": {
      "type": "object",
      "properties": {
        "noteId": {
          "$ref": "#/$defs/UUID"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "date": {
          "type": "string"
        }
      },
      "required": [
        "noteId",
        "title",
        "date"
      ],
      "additionalProperties": true
    },
    "ChatToolProgressDTO": {
      "type": "object",
      "properties": {
        "callId": {
          "$ref": "#/$defs/UUID"
        },
        "name": {
          "type": "string",
          "enum": [
            "search_meetings",
            "search_transcripts",
            "list_meetings",
            "get_meetings",
            "get_meeting_transcript"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "resultCount": {
          "type": "integer",
          "allOf": [
            {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ],
          "minimum": 0
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChatToolMeetingDTO"
          },
          "maxItems": 20
        }
      },
      "required": [
        "callId",
        "name",
        "status",
        "label"
      ],
      "additionalProperties": true
    }
  }
}
