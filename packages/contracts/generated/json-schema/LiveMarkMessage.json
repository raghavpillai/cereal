{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LiveMarkMessage",
  "$defs": {
    "LiveMarkKind": {
      "type": "string",
      "enum": [
        "pause",
        "resume",
        "end"
      ]
    },
    "LiveMarkMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "mark"
          ]
        },
        "kind": {
          "$ref": "#/$defs/LiveMarkKind"
        },
        "atSample": {
          "type": "object",
          "properties": {
            "mic": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "system": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "type",
        "kind",
        "atSample"
      ],
      "additionalProperties": true
    }
  }
}
