{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AuthMethodsDTO",
  "$defs": {
    "ServerTransport": {
      "type": "string",
      "enum": [
        "secure",
        "private",
        "public-http"
      ]
    },
    "AuthMethodsDTO": {
      "type": "object",
      "properties": {
        "password": {
          "type": "boolean"
        },
        "google": {
          "type": "boolean"
        },
        "instanceName": {
          "type": "string"
        },
        "setupRequired": {
          "type": "boolean"
        },
        "transport": {
          "$ref": "#/$defs/ServerTransport"
        }
      },
      "required": [
        "password",
        "google",
        "instanceName"
      ],
      "additionalProperties": true
    }
  }
}
