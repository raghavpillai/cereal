{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AuthMethodsDTO",
  "$defs": {
    "AuthMethodsDTO": {
      "type": "object",
      "properties": {
        "password": {
          "type": "boolean"
        },
        "google": {
          "type": "boolean"
        },
        "instanceName": {
          "type": "string"
        },
        "setupRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "password",
        "google",
        "instanceName"
      ],
      "additionalProperties": true
    }
  }
}
