{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CreateUserInput",
  "$defs": {
    "CreateUserInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "password": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128
        }
      },
      "required": [
        "name",
        "email",
        "password"
      ],
      "additionalProperties": true
    }
  }
}
