{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SharedWithMeEntryDTO",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "NoteAccessPersonDTO": {
      "type": "object",
      "properties": {
        "userId": {
          "$ref": "#/$defs/UUID"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "userId",
        "name",
        "email"
      ],
      "additionalProperties": true
    },
    "Timestamp": {
      "type": "string"
    },
    "SharedWithMeEntryDTO": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UUID"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "date": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/NoteAccessPersonDTO"
        },
        "sharedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "title",
        "date",
        "owner",
        "sharedAt"
      ],
      "additionalProperties": true
    }
  }
}
