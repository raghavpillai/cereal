{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LiveErrorMessage",
  "$defs": {
    "LiveErrorCode": {
      "type": "string",
      "enum": [
        "malformed",
        "unauthenticated",
        "not_found",
        "client_too_slow",
        "replaced",
        "over_limit",
        "provider_unavailable"
      ]
    },
    "LiveErrorMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "error"
          ]
        },
        "code": {
          "$ref": "#/$defs/LiveErrorCode"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": true
    }
  }
}
