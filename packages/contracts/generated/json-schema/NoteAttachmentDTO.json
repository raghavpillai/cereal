{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/NoteAttachmentDTO",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "Timestamp": {
      "type": "string"
    },
    "NoteAttachmentDTO": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UUID"
        },
        "noteId": {
          "$ref": "#/$defs/UUID"
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "noteId",
        "name",
        "mimeType",
        "createdAt"
      ],
      "additionalProperties": true
    }
  }
}
