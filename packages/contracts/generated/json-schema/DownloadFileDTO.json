{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DownloadFileDTO",
  "$defs": {
    "DownloadFileDTO": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "url",
        "size",
        "sha256"
      ],
      "additionalProperties": true
    }
  }
}
