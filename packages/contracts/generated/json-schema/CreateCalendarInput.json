{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CreateCalendarInput",
  "$defs": {
    "CreateCalendarInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4096
        },
        "color": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": true
    }
  }
}
