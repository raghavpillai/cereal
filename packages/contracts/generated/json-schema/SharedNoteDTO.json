{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SharedNoteDTO",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "Timestamp": {
      "type": "string"
    },
    "SharedNoteDTO": {
      "type": "object",
      "properties": {
        "shareId": {
          "$ref": "#/$defs/UUID"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "body": {
          "type": "string",
          "maxLength": 1000000
        },
        "enhanced": {
          "type": "string",
          "maxLength": 1000000
        },
        "date": {
          "type": "string"
        },
        "duration": {
          "type": "string",
          "maxLength": 32
        },
        "sharedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "shareId",
        "title",
        "body",
        "enhanced",
        "date",
        "duration",
        "sharedAt",
        "expiresAt"
      ],
      "additionalProperties": true
    }
  }
}
