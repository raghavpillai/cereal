{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/GenerationProgressDTO",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "GenerationState": {
      "type": "string",
      "enum": [
        "idle",
        "analyzing_transcript",
        "writing_notes",
        "ready",
        "failed",
        "unsupported"
      ]
    },
    "GenerationProgressDTO": {
      "type": "object",
      "properties": {
        "noteId": {
          "$ref": "#/$defs/UUID"
        },
        "transcriptRevision": {
          "type": "integer",
          "allOf": [
            {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ],
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/GenerationState"
        }
      },
      "required": [
        "noteId",
        "transcriptRevision",
        "state"
      ],
      "additionalProperties": true
    }
  }
}
