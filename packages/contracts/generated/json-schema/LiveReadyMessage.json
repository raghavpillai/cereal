{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LiveReadyMessage",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "AudioChannel": {
      "type": "string",
      "enum": [
        "mic",
        "system"
      ]
    },
    "LiveReadyStream": {
      "type": "object",
      "properties": {
        "channel": {
          "$ref": "#/$defs/AudioChannel"
        },
        "acceptFromSample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "channel",
        "acceptFromSample"
      ],
      "additionalProperties": true
    },
    "LiveReadyMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ready"
          ]
        },
        "sessionId": {
          "$ref": "#/$defs/UUID"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LiveReadyStream"
          }
        },
        "resumeWindowMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transcriptRevision": {
          "type": "integer",
          "allOf": [
            {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ],
          "minimum": 0
        }
      },
      "required": [
        "type",
        "sessionId",
        "provider",
        "model",
        "streams",
        "resumeWindowMs",
        "transcriptRevision"
      ],
      "additionalProperties": true
    }
  }
}
