{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/GoogleStatusDTO",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "Timestamp": {
      "type": "string"
    },
    "GoogleConnectionDTO": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UUID"
        },
        "email": {
          "type": "string"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "connected",
            "reconnect_required"
          ]
        },
        "contactsEnabled": {
          "type": "boolean"
        },
        "lastSyncedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastSyncError": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "email",
        "displayName",
        "status",
        "contactsEnabled",
        "lastSyncedAt",
        "lastSyncError",
        "createdAt"
      ],
      "additionalProperties": true
    },
    "GoogleStatusDTO": {
      "type": "object",
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "redirectUri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GoogleConnectionDTO"
          }
        }
      },
      "required": [
        "configured",
        "redirectUri",
        "connections"
      ],
      "additionalProperties": true
    }
  }
}
