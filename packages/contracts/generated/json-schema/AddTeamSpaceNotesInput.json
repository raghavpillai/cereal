{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AddTeamSpaceNotesInput",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "AddTeamSpaceNotesInput": {
      "type": "object",
      "properties": {
        "noteIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UUID"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "noteIds"
      ],
      "additionalProperties": true
    }
  }
}
