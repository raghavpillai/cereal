{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/GoogleVerificationStatusDTO",
  "$defs": {
    "GoogleVerificationStatusDTO": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "none",
            "pending",
            "done",
            "failed"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "additionalProperties": true
    }
  }
}
