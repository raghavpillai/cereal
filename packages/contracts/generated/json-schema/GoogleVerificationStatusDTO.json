{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/GoogleVerificationStatusDTO",
  "$defs": {
    "GoogleVerificationState": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "done",
        "failed"
      ]
    },
    "GoogleVerificationStatusDTO": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/GoogleVerificationState"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "additionalProperties": true
    }
  }
}
