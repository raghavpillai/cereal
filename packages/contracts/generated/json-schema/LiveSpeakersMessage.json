{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LiveSpeakersMessage",
  "$defs": {
    "LiveSpeakerMerge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": true
    },
    "LiveSpeakerRelabel": {
      "type": "object",
      "properties": {
        "segmentId": {
          "type": "string"
        },
        "speakerId": {
          "type": "string"
        },
        "speakerLabel": {
          "type": "string"
        }
      },
      "required": [
        "segmentId",
        "speakerId",
        "speakerLabel"
      ],
      "additionalProperties": true
    },
    "LiveSpeakersMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "speakers"
          ]
        },
        "merges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LiveSpeakerMerge"
          }
        },
        "relabels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LiveSpeakerRelabel"
          }
        }
      },
      "required": [
        "type",
        "merges"
      ],
      "additionalProperties": true
    }
  }
}
