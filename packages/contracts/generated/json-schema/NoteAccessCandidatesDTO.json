{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/NoteAccessCandidatesDTO",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "NoteAccessCandidateDTO": {
      "type": "object",
      "properties": {
        "userId": {
          "$ref": "#/$defs/UUID"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "maxLength": 2048
        },
        "attendee": {
          "type": "boolean"
        }
      },
      "required": [
        "userId",
        "name",
        "email",
        "attendee"
      ],
      "additionalProperties": true
    },
    "NoteAccessCandidatesDTO": {
      "type": "object",
      "properties": {
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NoteAccessCandidateDTO"
          }
        }
      },
      "required": [
        "people"
      ],
      "additionalProperties": true
    }
  }
}
