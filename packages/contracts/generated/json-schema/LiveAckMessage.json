{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LiveAckMessage",
  "$defs": {
    "AudioChannel": {
      "type": "string",
      "enum": [
        "mic",
        "system"
      ]
    },
    "LiveAckMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ack"
          ]
        },
        "channel": {
          "$ref": "#/$defs/AudioChannel"
        },
        "throughSample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transcribedThroughMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "channel",
        "throughSample",
        "transcribedThroughMs"
      ],
      "additionalProperties": true
    }
  }
}
