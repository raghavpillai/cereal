{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/OnboardingStepInput",
  "$defs": {
    "OnboardingStep": {
      "type": "string",
      "enum": [
        "owner",
        "name",
        "language",
        "speech",
        "models",
        "signIn",
        "storage"
      ]
    },
    "OnboardingStepState": {
      "type": "string",
      "enum": [
        "done",
        "skipped"
      ]
    },
    "OnboardingStepInput": {
      "type": "object",
      "properties": {
        "step": {
          "$ref": "#/$defs/OnboardingStep"
        },
        "state": {
          "$ref": "#/$defs/OnboardingStepState"
        }
      },
      "required": [
        "step",
        "state"
      ],
      "additionalProperties": true
    }
  }
}
