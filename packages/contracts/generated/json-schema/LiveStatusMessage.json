{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LiveStatusMessage",
  "$defs": {
    "AudioChannel": {
      "type": "string",
      "enum": [
        "mic",
        "system"
      ]
    },
    "LiveStreamState": {
      "type": "string",
      "enum": [
        "live",
        "catching_up",
        "provider_unavailable",
        "paused"
      ]
    },
    "LiveStatusMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "status"
          ]
        },
        "channel": {
          "$ref": "#/$defs/AudioChannel"
        },
        "state": {
          "$ref": "#/$defs/LiveStreamState"
        },
        "lagMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "channel",
        "state",
        "lagMs"
      ],
      "additionalProperties": true
    }
  }
}
