{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TranscriptionModelSelection",
  "$defs": {
    "TranscriptionModelSelection": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "elevenlabs",
            "openai"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": true
    }
  }
}
