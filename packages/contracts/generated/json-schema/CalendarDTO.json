{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CalendarDTO",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "Timestamp": {
      "type": "string"
    },
    "CalendarDTO": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UUID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider": {
          "type": "string",
          "enum": [
            "ics"
          ]
        },
        "color": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "sourceHost": {
          "type": "string"
        },
        "lastSyncedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastSyncError": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventCount": {
          "type": "integer",
          "allOf": [
            {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "name",
        "provider",
        "color",
        "enabled",
        "sourceHost",
        "lastSyncedAt",
        "lastSyncError",
        "eventCount",
        "createdAt"
      ],
      "additionalProperties": true
    }
  }
}
