{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ModelCatalogInput",
  "$defs": {
    "ModelCatalogInput": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openrouter",
            "openai",
            "anthropic",
            "elevenlabs",
            "openai_compatible"
          ]
        },
        "apiKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "baseUrl": {
          "type": "string",
          "minLength": 4,
          "maxLength": 2048
        },
        "refresh": {
          "type": "boolean"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": true
    }
  }
}
