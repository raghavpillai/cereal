{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/McpConnectionDTO",
  "$defs": {
    "Timestamp": {
      "type": "string"
    },
    "McpConnectionDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "clientId",
        "clientName",
        "scopes",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": true
    }
  }
}
