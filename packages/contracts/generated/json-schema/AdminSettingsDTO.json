{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AdminSettingsDTO",
  "$defs": {
    "ProviderStatusDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "openrouter",
            "openai",
            "anthropic",
            "elevenlabs"
          ]
        },
        "configured": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "environment",
            "stored",
            "none"
          ]
        }
      },
      "required": [
        "id",
        "configured",
        "source"
      ],
      "additionalProperties": true
    },
    "LanguageModelSelection": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openrouter",
            "openai",
            "anthropic"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": true
    },
    "TranscriptionModelSelection": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "elevenlabs",
            "openai"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": true
    },
    "LiveTranscriptionModelSelection": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "elevenlabs"
              ]
            }
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": true
    },
    "SignInSettingsDTO": {
      "type": "object",
      "properties": {
        "password": {
          "type": "boolean"
        },
        "google": {
          "type": "boolean"
        },
        "allowedEmails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "googleClientId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "googleClientSecretSet": {
          "type": "boolean"
        },
        "googleRedirectUris": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "password",
        "google",
        "allowedEmails",
        "googleClientId",
        "googleClientSecretSet",
        "googleRedirectUris"
      ],
      "additionalProperties": true
    },
    "StorageBackend": {
      "type": "string",
      "enum": [
        "local",
        "s3"
      ]
    },
    "StorageSettingsDTO": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/StorageBackend"
        },
        "source": {
          "type": "string",
          "enum": [
            "stored",
            "environment",
            "default"
          ]
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "prefix": {
          "type": "string"
        },
        "forcePathStyle": {
          "type": "boolean"
        },
        "accessKeyId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "secretAccessKeySet": {
          "type": "boolean"
        }
      },
      "required": [
        "backend",
        "source",
        "endpoint",
        "region",
        "bucket",
        "prefix",
        "forcePathStyle",
        "accessKeyId",
        "secretAccessKeySet"
      ],
      "additionalProperties": true
    },
    "AppsSettingsDTO": {
      "type": "object",
      "properties": {
        "iosAppIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "iosAppStoreId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "iosAppIds",
        "iosAppStoreId"
      ],
      "additionalProperties": true
    },
    "Timestamp": {
      "type": "string"
    },
    "OnboardingStepsDTO": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "boolean"
        },
        "name": {
          "type": "boolean"
        },
        "language": {
          "type": "boolean"
        },
        "speech": {
          "type": "boolean"
        },
        "models": {
          "type": "boolean"
        },
        "signIn": {
          "type": "boolean"
        },
        "storage": {
          "type": "boolean"
        }
      },
      "required": [
        "owner",
        "name",
        "language",
        "speech",
        "models",
        "signIn",
        "storage"
      ],
      "additionalProperties": true
    },
    "OnboardingDTO": {
      "type": "object",
      "properties": {
        "completedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "$ref": "#/$defs/OnboardingStepsDTO"
        }
      },
      "required": [
        "completedAt",
        "steps"
      ],
      "additionalProperties": true
    },
    "AdminSettingsDTO": {
      "type": "object",
      "properties": {
        "instanceName": {
          "type": "string"
        },
        "languageModel": {
          "type": "string"
        },
        "instanceLogo": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 350000
            },
            {
              "type": "null"
            }
          ]
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderStatusDTO"
          }
        },
        "chatModels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LanguageModelSelection"
          }
        },
        "generationModel": {
          "$ref": "#/$defs/LanguageModelSelection"
        },
        "transcriptionModel": {
          "$ref": "#/$defs/TranscriptionModelSelection"
        },
        "liveTranscriptionModel": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveTranscriptionModelSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "openRouterConfigured": {
          "type": "boolean"
        },
        "elevenLabsConfigured": {
          "type": "boolean"
        },
        "openRouterSource": {
          "type": "string",
          "enum": [
            "environment",
            "stored",
            "none"
          ]
        },
        "elevenLabsSource": {
          "type": "string",
          "enum": [
            "environment",
            "stored",
            "none"
          ]
        },
        "calendarRefreshMinutes": {
          "type": "integer",
          "allOf": [
            {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ]
        },
        "calendarLookAheadDays": {
          "type": "integer",
          "allOf": [
            {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ]
        },
        "signIn": {
          "$ref": "#/$defs/SignInSettingsDTO"
        },
        "storage": {
          "$ref": "#/$defs/StorageSettingsDTO"
        },
        "liveMaxSessions": {
          "type": "integer",
          "allOf": [
            {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ]
        },
        "liveHoldSeconds": {
          "type": "integer",
          "allOf": [
            {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ]
        },
        "apps": {
          "$ref": "#/$defs/AppsSettingsDTO"
        },
        "unusedEnvironment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "onboarding": {
          "$ref": "#/$defs/OnboardingDTO"
        },
        "updatedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instanceName",
        "languageModel",
        "instanceLogo",
        "providers",
        "chatModels",
        "generationModel",
        "transcriptionModel",
        "openRouterConfigured",
        "elevenLabsConfigured",
        "openRouterSource",
        "elevenLabsSource",
        "calendarRefreshMinutes",
        "calendarLookAheadDays",
        "updatedAt"
      ],
      "additionalProperties": true
    }
  }
}
