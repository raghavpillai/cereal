{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ChatToolMeetingDTO",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "ChatToolMeetingDTO": {
      "type": "object",
      "properties": {
        "noteId": {
          "$ref": "#/$defs/UUID"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "date": {
          "type": "string"
        }
      },
      "required": [
        "noteId",
        "title",
        "date"
      ],
      "additionalProperties": true
    }
  }
}
