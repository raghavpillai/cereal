{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/UpdateNoteContextInput",
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid",
      "description": "UUID encoded as a string"
    },
    "UpdateNoteContextInput": {
      "type": "object",
      "properties": {
        "eventId": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "eventId"
      ],
      "additionalProperties": true
    }
  }
}
