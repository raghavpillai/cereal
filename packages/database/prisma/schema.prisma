generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AudioChannel {
  mic
  system
}

model Note {
  organizationId String? @db.Uuid
  organization Organization? @relation(fields:[organizationId],references:[id],onDelete:SetNull)
  @@index([ownerId, organizationId, date])
  ownerId String @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  @@index([ownerId, updatedAt])
  id                 String              @id @default(uuid()) @db.Uuid
  title              String              @default("")
  body               String              @default("")
  enhanced           String              @default("")
  date               DateTime            @db.Date
  duration           String              @default("") @db.VarChar(32)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  recordingState     String              @default("idle") @db.VarChar(32)
  generationState    String              @default("idle") @db.VarChar(32)
  transcriptRevision Int                 @default(0)
  generatedRevision  Int?
  generationRun      String?             @db.Uuid
  /// Set once, by POST /api/v1/notes/import: when the note arrived, and the SHA-256 of the request that made it.
  importedAt         DateTime?           @db.Timestamptz(3)
  importDigest       String?             @db.Char(64)
  /// The "Chat with meeting transcript" line last added to the generated notes, as written; null when none ever was.
  /// A regeneration replaces it only while it is still in the notes unchanged (apps/api/src/transcript-link.ts).
  transcriptLink     String?
  transcriptSegments TranscriptSegment[]
  shares             SharedNote[]
  calendarMeeting    CalendarMeeting?
  meetingContext     NoteMeetingContext?
  googleMeeting      GoogleMeeting?
  attachments NoteAttachment[]
  liveCoverage       LiveCoverage[]
  liveGaps           LiveGap[]
  speakers           NoteSpeaker[]
  chatThreads        ChatThread[]
  teamSpace          TeamSpaceNote?
  sharing            NoteSharing?
  access             NoteAccess[]

  @@index([updatedAt(sort: Desc)])
}

model TranscriptSegment {
  id           String       @id @default(uuid()) @db.Uuid
  noteId       String       @db.Uuid
  channel      AudioChannel
  speakerId    String       @db.VarChar(100)
  speakerLabel String?      @db.VarChar(200)
  text         String
  isFinal      Boolean      @default(false)
  startMs      Int
  endMs        Int?
  /// "live" (the streaming session) or "batch": a segment a client wrote or imported, or one transcribed from an
  /// uploaded part by an older version.
  origin       String       @default("batch") @db.VarChar(16)
  note         Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, startMs])
}

/// Ledger of note-timeline audio the live session has accounted for (stored final text for it, or heard
/// silence), so a reconnect resumes where it ended and nothing is transcribed twice.
/// Stretches of a recording that were captured but will never have a transcript: the client skipped a backlog
/// longer than the resume window, or the recogniser could not take them. Shown in the transcript as "missing".
model LiveGap {
  id        String       @id @default(uuid()) @db.Uuid
  noteId    String       @db.Uuid
  channel   AudioChannel
  fromMs    Int
  toMs      Int
  reason    String       @db.VarChar(32)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  note      Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, fromMs])
}

model LiveCoverage {
  id        String       @id @default(uuid()) @db.Uuid
  noteId    String       @db.Uuid
  channel   AudioChannel
  fromMs    Int
  toMs      Int
  sessionId String?      @db.Uuid
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  note      Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, channel, fromMs])
}

/// A voice within one channel of one note, numbered in order of first appearance.
/// Live segments carry speakerId "<channel>:n:<number>".
model NoteSpeaker {
  id           String       @id @default(uuid()) @db.Uuid
  noteId       String       @db.Uuid
  channel      AudioChannel
  number       Int
  displayName  String?      @db.VarChar(200)
  mergedIntoId String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  note         Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, channel, number])
}

model SharedNote {
  id        String    @id @default(uuid()) @db.Uuid
  noteId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  snapshot  Json
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt(sort: Desc)])
}

model InstanceSettings {
  id                     String   @id @default("instance")
  instanceName           String   @default("Cereal") @db.VarChar(100)
  languageModel          String?  @db.VarChar(150)
  instanceLogo           String?
  chatModels             Json?
  generationModel        Json?
  /// {provider, model} of the speech-to-text model, which always streams (speech is transcribed live only). Live
  /// transcription is always on: null reads as the default live model.
  liveTranscriptionModel Json?
  openAiSecret           String?
  anthropicSecret        String?
  openRouterSecret       String?
  elevenLabsSecret       String?
  /// Where an OpenAI-compatible server's API starts (http or https, tidied, no credentials); null: not connected.
  openAiCompatibleBaseUrl String? @db.VarChar(2048)
  /// Its optional API key, sealed like the others.
  openAiCompatibleSecret String?
  calendarRefreshMinutes Int      @default(15)
  calendarLookAheadDays   Int      @default(30)
  /// Which ways of signing in are offered. At least one stays on; the bootstrap owner token always works.
  signInPassword         Boolean  @default(true)
  signInGoogle           Boolean  @default(false)
  /// Lower-cased addresses and "@domain" entries that may create an account by signing in with Google.
  signInAllowedEmails    Json?
  /// Google OAuth web client, shared by Google sign-in and the Google Calendar connection. The secret is sealed.
  googleClientId         String?  @db.VarChar(255)
  googleClientSecret     String?
  /// Where audio and app builds are kept: "local" or "s3". Null: nobody has chosen (the environment, else local disk).
  storageBackend         String?  @db.VarChar(16)
  /// {endpoint, region, bucket, prefix, forcePathStyle, accessKeyId} of the S3-compatible bucket. The secret is sealed.
  storageS3              Json?
  storageS3Secret        String?
  /// Live transcription limits; null means the built-in default (20 sessions, 300 seconds).
  liveMaxSessions        Int?
  liveHoldSeconds        Int?
  /// The iPhone app: app IDs that may open note links (null: the Cereal app), and its App Store ID.
  iosAppIds              Json?
  iosAppStoreId          String?  @db.VarChar(20)
  /// Names of environment variables whose values were taken into these settings once; they are not read again.
  importedEnvironment    Json?
  /// First-run setup on the admin panel: when it was finished (null: not yet), and which steps were confirmed
  /// or skipped there, such as {"signIn":"done","storage":"skipped"}.
  onboardingCompletedAt  DateTime? @db.Timestamptz(3)
  onboardingSteps        Json?
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
}

model CalendarSubscription {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(200)
  provider        String   @default("ics") @db.VarChar(32)
  color           String   @default("#87e5e8") @db.Char(7)
  enabled         Boolean  @default(true)
  encryptedURL    String
  sourceHost      String   @db.VarChar(253)
  lastSyncedAt    DateTime? @db.Timestamptz(3)
  lastSyncError   String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  events          CalendarEvent[]
}

model CalendarEvent {
  id           String @id @db.Uuid
  calendarId   String @db.Uuid
  sourceKey    String @db.Char(64)
  meetingKey   String @db.Char(64)
  title        String @db.VarChar(500)
  startAt      DateTime @db.Timestamptz(3)
  endAt        DateTime @db.Timestamptz(3)
  allDay       Boolean @default(false)
  startDate    String @db.Char(10)
  endDate      String @db.Char(10)
  timeZone     String? @db.VarChar(200)
  location     String? @db.VarChar(1000)
  meetingUrl   String? @db.VarChar(4096)
  /// The iCalendar UID and which occurrence this is; filled at the next sync after they were added.
  meetingUid   String? @db.VarChar(2048)
  occurrence   String? @db.VarChar(40)
  /// Invitees other than the organizer, rooms and equipment left out.
  attendeeCount Int?
  calendar     CalendarSubscription @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, sourceKey])
  @@index([startAt, endAt])
  @@index([meetingKey])
}

model CalendarMeeting {
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  meetingKey String @db.Char(64)
  @@id([userId,meetingKey])
  noteId     String @unique @db.Uuid
  note       Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model User {
 oauthClientUserIdChildren OauthClient[] @relation("mcpOauthClientUserId")
 oauthRefreshTokenUserIdChildren OauthRefreshToken[] @relation("mcpOauthRefreshTokenUserId")
 oauthAccessTokenUserIdChildren OauthAccessToken[] @relation("mcpOauthAccessTokenUserId")
 oauthConsentUserIdChildren OauthConsent[] @relation("mcpOauthConsentUserId")
 workspaceState UserWorkspaceState?
 agentBriefs AgentBrief[]
 id String @id @db.Uuid
 name String
 email String @unique
 emailVerified Boolean @default(false)
 image String?
 role String @default("user") @db.VarChar(16)
 banned Boolean @default(false)
 banReason String?
 banExpires DateTime? @db.Timestamptz(3)
 memberships Member[]
 invitations Invitation[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 sessions Session[]
 accounts Account[]
 notes Note[]
 calendarMeetings CalendarMeeting[]
 googleConnections GoogleConnection[]
 appSignInHandoffs AppSignInHandoff[]
 googleStates GoogleOAuthState[]
 meetingContexts NoteMeetingContext[]
 googleMeetings GoogleMeeting[]
 chatThreads ChatThread[]
 noteAccess NoteAccess[]
}
model Session {
 oauthRefreshTokenSessionIdChildren OauthRefreshToken[] @relation("mcpOauthRefreshTokenSessionId")
 oauthAccessTokenSessionIdChildren OauthAccessToken[] @relation("mcpOauthAccessTokenSessionId")
 id String @id @db.Uuid
 token String @unique
 expiresAt DateTime @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 ipAddress String?
 userAgent String?
 impersonatedBy String? @db.Uuid
 activeOrganizationId String? @db.Uuid
 activeOrganization Organization? @relation(fields:[activeOrganizationId],references:[id],onDelete:SetNull)
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId])
}
model Account {
 id String @id @db.Uuid
 accountId String
 providerId String
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 accessToken String?
 refreshToken String?
 idToken String?
 accessTokenExpiresAt DateTime? @db.Timestamptz(3)
 refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
 scope String?
 password String?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([userId])
 @@unique([providerId,accountId])
}
model Verification {
 id String @id @db.Uuid
 identifier String
 value String
 expiresAt DateTime @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([identifier])
}

model GoogleOAuthState {
 stateHash String @id @db.Char(64)
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 sessionHash String @db.Char(64)
 encryptedVerifier String
 contacts Boolean @default(false)
 expiresAt DateTime @db.Timestamptz(3)
 @@index([expiresAt])
}
/// One Google sign-in in progress. No account exists yet, so it is bound to the browser by a cookie.
model GoogleSignInState {
 stateHash String @id @db.Char(64)
 browserHash String @db.Char(64)
 encryptedVerifier String
 returnPath String @db.VarChar(16384)
 expiresAt DateTime @db.Timestamptz(3)
 @@index([expiresAt])
}
/// A Google sign-in that proves a Google client before the server trusts it: claiming a new server with Google
/// ("claim"), or an administrator switching the server to Google ("switch"). The setup code or the administrator's
/// session was checked when the row was made; the browser that made it holds a random value in an HttpOnly cookie
/// and only its hash is here. Single use: `outcome` is set once ("done" or the reason it failed), and the sealed
/// client secret is cleared at the same moment. Rows expire after ten minutes.
model GoogleVerification {
 stateHash String @id @db.Char(64)
 browserHash String @db.Char(64)
 purpose String @db.VarChar(16)
 userId String? @db.Uuid
 clientId String @db.VarChar(255)
 encryptedSecret String?
 encryptedVerifier String
 outcome String? @db.VarChar(32)
 expiresAt DateTime @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([browserHash])
 @@index([expiresAt])
}
/// A signed-in browser handing its account to an app: single use, short lived, redeemed with the PKCE verifier.
model AppSignInHandoff {
 codeHash String @id @db.Char(64)
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 challenge String @db.Char(43)
 expiresAt DateTime @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([userId])
 @@index([expiresAt])
}
model GoogleConnection {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 subject String @db.VarChar(255)
 email String @db.VarChar(254)
 displayName String? @db.VarChar(500)
 encryptedGrant String
 contactsEnabled Boolean @default(false)
 status String @default("connected") @db.VarChar(32)
 lastSyncedAt DateTime? @db.Timestamptz(3)
 lastSyncError String?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 calendars GoogleCalendar[]
 @@unique([userId,subject])
 @@index([userId])
}
model GoogleCalendar {
 id String @id @default(uuid()) @db.Uuid
 connectionId String @db.Uuid
 connection GoogleConnection @relation(fields:[connectionId],references:[id],onDelete:Cascade)
 remoteId String @db.VarChar(1024)
 name String @db.VarChar(200)
 color String @db.Char(7)
 timeZone String @db.VarChar(200)
 primary Boolean @default(false)
 selected Boolean @default(false)
 accessRole String @db.VarChar(64)
 events GooglePersonalEvent[]
 @@unique([connectionId,remoteId])
}
model GooglePersonalEvent {
 id String @id @db.Uuid
 calendarId String @db.Uuid
 calendar GoogleCalendar @relation(fields:[calendarId],references:[id],onDelete:Cascade)
 remoteId String @db.VarChar(1024)
 meetingKey String @db.Char(64)
 title String @db.VarChar(500)
 startAt DateTime @db.Timestamptz(3)
 endAt DateTime @db.Timestamptz(3)
 allDay Boolean
 startDate String @db.Char(10)
 endDate String @db.Char(10)
 timeZone String? @db.VarChar(200)
 location String? @db.VarChar(1000)
 meetingUrl String? @db.VarChar(4096)
 meetingUid String? @db.VarChar(2048)
 occurrence String? @db.VarChar(40)
 context Json
 @@index([startAt,endAt])
 @@unique([calendarId,remoteId])
}
model GoogleMeeting {
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 meetingKey String @db.Char(64)
 @@id([userId,meetingKey])
 noteId String @unique @db.Uuid
 note Note @relation(fields:[noteId],references:[id],onDelete:Cascade)
}
model NoteMeetingContext {
 noteId String @id @db.Uuid
 note Note @relation(fields:[noteId],references:[id],onDelete:Cascade)
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 meeting Json
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([userId])
}

// Better Auth Organization plugin. Membership never changes Note.ownerId.
model Organization {
 notes Note[]
 workspaceSelections UserWorkspaceState[]
 agentBriefs AgentBrief[]
 teamSpaceNotes TeamSpaceNote[]
 id String @id @db.Uuid
 name String @db.VarChar(100)
 slug String @unique @db.VarChar(100)
 logo String?
 metadata String?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 members Member[]
 invitations Invitation[]
 sessions Session[]
}
model Member {
 id String @id @db.Uuid
 organizationId String @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 role String @default("member") @db.VarChar(16)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([organizationId,userId])
 @@index([userId])
}
model Invitation {
 id String @id @db.Uuid
 organizationId String @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 email String @db.VarChar(254)
 role String @default("member") @db.VarChar(16)
 status String @default("pending") @db.VarChar(16)
 inviterId String @db.Uuid
 inviter User @relation(fields:[inviterId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 expiresAt DateTime @db.Timestamptz(3)
 @@index([organizationId,status])
 @@index([email,status])
}

// Workspace navigation never expands private-note ownership.
model UserWorkspaceState {
 userId String @id @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 activeOrganizationId String? @db.Uuid
 activeOrganization Organization? @relation(fields:[activeOrganizationId],references:[id],onDelete:SetNull)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
/// How far a note's links reach, when that is not the default. No row: "invited", not suspended.
/// `level` "invited": only the owner and the people in NoteAccess. "organization": every member of the note's
/// workspace who holds a link. `suspended`: the owner put the note in Trash; nobody else reads it meanwhile.
/// Kept out of Note so that changing who can read a note never changes the note's own `updatedAt`.
model NoteSharing {
 noteId String @id @db.Uuid
 note Note @relation(fields:[noteId],references:[id],onDelete:Cascade)
 level String @default("invited") @db.VarChar(16)
 suspended Boolean @default(false)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
/// One person a note is shared with. They read it only while they are a member of the note's workspace
/// (Note.organizationId), which is checked at every read; the row goes with the note and with the account.
model NoteAccess {
 noteId String @db.Uuid
 note Note @relation(fields:[noteId],references:[id],onDelete:Cascade)
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 addedById String @db.Uuid
 addedAt DateTime @default(now()) @db.Timestamptz(3)
 @@id([noteId,userId])
 @@index([userId, addedAt(sort: Desc)])
}
/// A note its owner shows to a whole workspace: the workspace's "team space". The row is the whole grant.
/// While it exists every member of `organizationId` may read the note's title and documents (never its
/// transcript or audio, and never to change it); deleting the row, the note, or the membership ends that
/// at once. A note is in at most one space. `addedById` is the owner who put it there.
model TeamSpaceNote {
 noteId String @id @db.Uuid
 note Note @relation(fields:[noteId],references:[id],onDelete:Cascade)
 organizationId String @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 addedById String @db.Uuid
 addedAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([organizationId, addedAt(sort: Desc)])
}
model NoteAttachment {
 id String @id @default(uuid()) @db.Uuid
 noteId String @db.Uuid
 note Note @relation(fields:[noteId],references:[id],onDelete:Cascade)
 name String @db.VarChar(255)
 mimeType String @db.VarChar(40)
 data Bytes
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([noteId,createdAt])
}
model AgentBrief {
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 organizationId String @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 body String @default("")
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@id([userId,organizationId])
}

/// A chat conversation. It is one person's for life (`userId`) and nobody else's, administrators included:
/// every query names its owner. A thread about a note (`noteId`) is deleted with the note, because its
/// answers quote what the note held; one across all notes has no `noteId`. `title` is null until the first
/// exchange has been answered and named (the apps show "Untitled thread").
model ChatThread {
 id String @id @db.Uuid
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 noteId String? @db.Uuid
 note Note? @relation(fields:[noteId],references:[id],onDelete:Cascade)
 title String? @db.VarChar(200)
 /// Who named it: "generated" (the model, after the first exchange), "question" (its first question, when
 /// the model could not), "user" (renamed). A thread a person renamed is never renamed for them.
 titleSource String? @db.VarChar(16)
 /// Exchanges (a question and its answer) in the thread; positions run from 0 to 2 * turnCount - 1.
 turnCount Int @default(0)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @db.Timestamptz(3)
 messages ChatMessage[]
 @@index([userId, updatedAt(sort: Desc), id(sort: Desc)])
 @@index([userId, noteId, updatedAt(sort: Desc)])
 @@index([noteId])
}
/// One message of a thread. Exchange `n` is the question at position 2n and its answer at 2n + 1. An answer
/// is written while it streams ("streaming") and settles as "complete", "interrupted" (stopped or cut off,
/// with what had arrived) or "failed" (with `error`).
model ChatMessage {
 id String @id @db.Uuid
 threadId String @db.Uuid
 thread ChatThread @relation(fields:[threadId],references:[id],onDelete:Cascade)
 position Int
 role String @db.VarChar(16)
 content String @default("")
 status String @default("complete") @db.VarChar(16)
 error String? @db.VarChar(2000)
 model String? @db.VarChar(200)
 citations Json @default("[]")
 tools Json @default("[]")
 reasoning Json @default("[]")
 elapsedMs Int?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @db.Timestamptz(3)
 @@unique([threadId, position])
}

// Exact installed Better Auth MCP/OAuth-provider and JWT plugin tables.
model OauthClient {
 id String @id @default(uuid())
 clientId String @unique
 clientSecret String?
 clientDiscoveryId String?
 disabled Boolean? @default(false)
 skipConsent Boolean?
 enableEndSession Boolean?
 subjectType String?
 scopes String[] @default([])
 clientCredentialsScopes String[] @default([])
 userId String? @db.Uuid
 @@index([userId])
 user User? @relation("mcpOauthClientUserId",fields:[userId],references:[id],onDelete:Cascade)
 createdAt DateTime? @db.Timestamptz(3)
 updatedAt DateTime? @db.Timestamptz(3)
 name String?
 uri String?
 icon String?
 contacts String[] @default([])
 tos String?
 policy String?
 softwareId String?
 softwareVersion String?
 softwareStatement String?
 redirectUris String[] @default([])
 postLogoutRedirectUris String[] @default([])
 backchannelLogoutUri String?
 backchannelLogoutSessionRequired Boolean?
 tokenEndpointAuthMethod String?
 applicationType String?
 jwks String?
 jwksUri String?
 grantTypes String[] @default([])
 responseTypes String[] @default([])
 requirePKCE Boolean?
 dpopBoundAccessTokens Boolean? @default(false)
 referenceId String?
 metadata Json?
 oauthClientResourceClientIdChildren OauthClientResource[] @relation("mcpOauthClientResourceClientId")
 oauthRefreshTokenClientIdChildren OauthRefreshToken[] @relation("mcpOauthRefreshTokenClientId")
 oauthAccessTokenClientIdChildren OauthAccessToken[] @relation("mcpOauthAccessTokenClientId")
 oauthConsentClientIdChildren OauthConsent[] @relation("mcpOauthConsentClientId")
}
model OauthResource {
 id String @id @default(uuid())
 identifier String @unique
 name String
 accessTokenTtl Int?
 refreshTokenTtl Int?
 signingAlgorithm String?
 signingKeyId String?
 allowedScopes String[] @default([])
 customClaims Json?
 dpopBoundAccessTokensRequired Boolean? @default(false)
 disabled Boolean? @default(false)
